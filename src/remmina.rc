#include <windows.h>

// Application icon
IDI_ICON1 ICON "remmina.ico"

// Version information
VS_VERSION_INFO VERSIONINFO
FILEVERSION     1,4,43,0
PRODUCTVERSION  1,4,43,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Remmina Project"
            VALUE "FileDescription",  "Remmina Remote Desktop Client"
            VALUE "FileVersion",      "1.4.43.0"
            VALUE "InternalName",     "remmina"
            VALUE "LegalCopyright",   "Copyright (C) 2010-2026 Remmina Project"
            VALUE "OriginalFilename", "remmina.exe"
            VALUE "ProductName",      "Remmina"
            VALUE "ProductVersion",   "1.4.43.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
